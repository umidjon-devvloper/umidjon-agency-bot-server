# Copy to .env and fill in. .env holds credentials — never commit it.

# --- Telegram ---------------------------------------------------------------
# TELEGRAM_BOT_TOKEN — @BotFather bergan token.
TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID — lead tushadigan chat. Bir nechta bo'lsa vergul bilan:
#   123456789,-1001234567890
# Bilmasangiz: botni ishga tushiring, botga /start yozing — bot chat id ni
# o'zi javob qilib beradi (BOT_POLLING=true bo'lganda).
TELEGRAM_CHAT_ID=

# --- Server -----------------------------------------------------------------
PORT=8787
# Saytdan to'g'ridan-to'g'ri so'rov kelsa — ruxsat etilgan originlar (vergul bilan).
# Bo'sh qoldirilsa brauzerdan kelgan cross-origin so'rovlar rad etiladi.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# LEAD_API_KEY — sayt backendi shu kalit bilan murojaat qiladi (x-api-key header).
# Bo'sh qoldirilsa kalit tekshirilmaydi (faqat local test uchun).
LEAD_API_KEY=

# --- Bot rejimi -------------------------------------------------------------
# true bo'lsa server botni long-polling orqali tinglaydi (/start, /id, /ping).
# Webhook ishlatsangiz false qoldiring — ikkalasi bir vaqtda ishlamaydi.
BOT_POLLING=true
# Webhook rejimi uchun: /api/telegram/webhook manzili shu maxfiy so'z bilan himoyalanadi.
TELEGRAM_WEBHOOK_SECRET=
